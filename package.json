{
  "name": "cord",
  "version": "0.0.0",
  "private": true,
  "description": "Self-host edilebilir Discord benzeri iletişim platformu monoreposu.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:check": "docker compose config --quiet"
  }
}
