{
  "name": "cord",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hostable Discord like communication platform monorepo.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:check": "docker compose config --quiet",
    "dev": "pnpm client:deps && pnpm --filter @cord/web dev",
    "build": "pnpm client:deps && pnpm --filter @cord/web build",
    "typecheck": "pnpm client:deps && vue-tsc --noEmit -p tsconfig.json && pnpm --filter @cord/desktop typecheck:main && pnpm api:typecheck",
    "desktop:dev": "pnpm client:deps && pnpm --filter @cord/desktop dev",
    "desktop:build": "pnpm client:deps && pnpm --filter @cord/desktop build",
    "mobile:dev": "pnpm client:deps && pnpm --filter @cord/mobile dev",
    "mobile:build": "pnpm client:deps && pnpm --filter @cord/mobile build",
    "mobile:add:android": "pnpm --filter @cord/mobile add:android",
    "mobile:add:ios": "pnpm --filter @cord/mobile add:ios",
    "mobile:android": "pnpm client:deps && pnpm --filter @cord/mobile android",
    "mobile:ios": "pnpm client:deps && pnpm --filter @cord/mobile ios",
    "mobile:sync": "pnpm client:deps && pnpm --filter @cord/mobile sync",
    "api:dev": "pnpm --filter @cord/api dev",
    "api:build": "pnpm --filter @cord/api build",
    "api:typecheck": "pnpm --filter @cord/api typecheck",
    "api:test": "pnpm --filter @cord/api test",
    "test": "pnpm api:test",
    "mobile:android:check": "pnpm --filter @cord/mobile android:check",
    "client:deps": "pnpm -r --filter @cord/sdk... build",
    "db:generate": "pnpm --filter @cord/database generate",
    "db:migrate": "pnpm --filter @cord/database migrate:deploy",
    "db:migrate:dev": "pnpm --filter @cord/database migrate:dev",
    "desktop:test": "pnpm --filter @cord/desktop test",
    "client:test": "pnpm client:deps && pnpm --filter @cord/client test",
    "desktop:package": "pnpm client:deps && pnpm --filter @cord/desktop package",
    "mobile:apk": "pnpm client:deps && pnpm --filter @cord/mobile apk",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.9.3",
    "vite-plus": "^1.4.0",
    "vue-tsc": "^3.3.14"
  }
}
