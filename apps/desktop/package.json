{
  "name": "@cord/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Electron main, preload ve ortak Vue renderer giri\u015fi.",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.1.0"
  },
  "type": "module",
  "dependencies": {
    "@cord/client": "workspace:*",
    "@cord/ui": "workspace:*",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "typecheck:main": "tsc --noEmit -p tsconfig.main.json",
    "build:renderer": "vp build",
    "build": "pnpm build:main && pnpm build:renderer",
    "dev": "pnpm build && pnpm start",
    "start": "node scripts/start.ts",
    "test": "vp test run",
    "package": "pnpm build && node scripts/package.ts"
  },
  "productName": "Cord"
}
