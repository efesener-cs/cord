{
  "name": "@cord/api",
  "version": "0.0.0",
  "private": true,
  "description": "Express/TypeScript HTTP API foundation.",
  "dependencies": {
    "@cord/contracts": "workspace:*",
    "@cord/database": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "livekit-server-sdk": "^2.19.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --filter @cord/database --filter @cord/contracts build && node --env-file-if-exists=../../.env --watch src/server.ts",
    "build": "pnpm -r --filter @cord/database --filter @cord/contracts build && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "pnpm -r --filter @cord/database --filter @cord/contracts build && tsc --noEmit -p tsconfig.json",
    "test": "pnpm -r --filter @cord/database --filter @cord/contracts build && vp test run",
    "test:watch": "vp test watch"
  }
}
