{
  "name": "@cord/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Capacitor kabuğu ve ortak Vue mobil girişi.",
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@cord/client": "workspace:*",
    "@cord/ui": "workspace:*",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview --host 127.0.0.1 --port 5175",
    "add:android": "pnpm build && cap add android",
    "add:ios": "pnpm build && cap add ios",
    "sync": "pnpm build && cap sync",
    "android": "node scripts/android.ts",
    "ios": "pnpm build && cap sync ios && cap run ios",
    "android:check": "node scripts/android.ts --check",
    "apk": "node scripts/android.ts --apk"
  }
}
