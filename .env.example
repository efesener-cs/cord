# Development database initialization; the current API does not connect to PostgreSQL yet.
# Host: postgresql://cord:cord@127.0.0.1:5433/cord
# Compose network: postgresql://cord:cord@postgres:5432/cord
POSTGRES_DB=cord
POSTGRES_USER=cord
POSTGRES_PASSWORD=cord
POSTGRES_PORT=5433

# Local bundled frontend preview (Caddy). Vite development stays on 5173.
WEB_PORT=8081

# API host port; the API container listens on 3000.
API_PORT=3001
