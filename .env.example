# Local development database and API settings.
# DATABASE_URL is used by host-run API/Prisma commands; Compose builds its own internal URL.
# Compose network: postgresql://cord:cord@postgres:5432/cord
POSTGRES_DB=cord
POSTGRES_USER=cord
POSTGRES_PASSWORD=cord
POSTGRES_PORT=5433

# Local bundled frontend preview (Caddy). Vite development stays on 5173.
WEB_PORT=8081

# API host port; the API container listens on 3000.
API_PORT=3001

DATABASE_URL=postgresql://cord:cord@127.0.0.1:5433/cord
# Explicit CORS origins for local Electron file:// preview only; no wildcard/credentialed CORS.
# Set to an empty value for same-origin public web hosting.
API_ALLOWED_ORIGINS=null
# Native renderer builds may use VITE_API_URL (public API origin, never a database URL).
