# Local development database and API settings.
# DATABASE_URL is used by host-run API/Prisma commands; Compose builds its own internal URL.
# Compose network: postgresql://cord:cord@postgres:5432/cord
POSTGRES_DB=cord
POSTGRES_USER=cord
POSTGRES_PASSWORD=cord
POSTGRES_PORT=5433

# Local bundled frontend preview (Caddy). Vite development stays on 5173.
WEB_PORT=8081

# API host port; the API container listens on 3000.
API_PORT=3001

DATABASE_URL=postgresql://cord:cord@127.0.0.1:5433/cord
# Explicit CORS origins for local Electron file:// preview only; no wildcard/credentialed CORS.
# Set to an empty value for same-origin public web hosting.
API_ALLOWED_ORIGINS=null,https://localhost,capacitor://localhost
# Native Vite adapters load this root file. VITE_API_URL overrides the platform defaults.
# These values are public API origins, never database URLs.
VITE_DESKTOP_API_URL=http://127.0.0.1:3001
VITE_ANDROID_API_URL=http://10.0.2.2:3001
# VITE_IOS_API_URL=https://your-api.example

# Cookie sessions: local HTTP preview only. Enable Secure for an HTTPS deployment.
COOKIE_SECURE=false
# Exact browser origins permitted to make cookie-authenticated writes (CSRF policy).
API_WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# Local-only media defaults. Change the key and secret before sharing a deployment.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=cord-local
LIVEKIT_API_SECRET=local-development-media-secret-change-before-sharing
# Desktop builds allow this origin in the renderer CSP.
VITE_MEDIA_URL=ws://localhost:7880
# Host API uploads (ignored by Git); containers use the persistent uploads-data volume.
UPLOAD_DIRECTORY=../../.data/uploads

# Optional closed-app Android push: disabled without operator Firebase setup.
PUSH_ENABLED=false
VITE_PUSH_ENABLED=false
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/firebase-service-account.json
# PUSH_CREDENTIALS_FILE=/absolute/private/firebase-service-account.json
# Android build only, after supplying apps/mobile/android/app/google-services.json:
# VITE_PUSH_ENABLED=true
